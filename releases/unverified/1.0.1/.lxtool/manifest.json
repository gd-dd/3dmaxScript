{
  "schemaVersion": 2,
  "kind": "lx-tool",
  "name": "Max 工具集",
  "description": "动画、建模和导入常用脚本，一处安装与启动。",
  "version": "1.0.1",
  "category": "DCC 工具",
  "icon": ".lxtool/icon.png",
  "readme": ".lxtool/README.md",
  "panel": ".lxtool/panel.json",
  "applications": {
    "max": {
      "name": "3ds Max",
      "executable": "3dsmax.exe",
      "compatibility": {
        "range": "unverified",
        "testedVersions": []
      }
    }
  },
  "actions": {
    "launch": {
      "type": "process",
      "application": "max",
      "arguments": []
    },
    "folder": {
      "type": "openFolder"
    },
    "animation-bake": {
      "type": "process",
      "application": "max",
      "arguments": [
        "-U",
        "MAXScript",
        "{file:动画烘焙工具.ms}"
      ]
    },
    "keyframe-formula": {
      "type": "process",
      "application": "max",
      "arguments": [
        "-U",
        "MAXScript",
        "{file:自定义公式关键帧.ms}"
      ]
    },
    "material-split": {
      "type": "process",
      "application": "max",
      "arguments": [
        "-U",
        "MAXScript",
        "{file:按材质ID拆分模型.ms}"
      ]
    },
    "parent-keep-world": {
      "type": "process",
      "application": "max",
      "arguments": [
        "-U",
        "MAXScript",
        "{file:保持位移建立父子.ms}"
      ]
    },
    "pmx-import": {
      "type": "process",
      "application": "max",
      "arguments": [
        "-U",
        "MAXScript",
        "{file:PMX导入.ms}"
      ]
    },
    "root-cleanup": {
      "type": "process",
      "application": "max",
      "arguments": [
        "-U",
        "MAXScript",
        "{file:清理根骨骼.ms}"
      ]
    },
    "install": {
      "type": "copy",
      "files": [
        "动画烘焙工具.ms",
        "自定义公式关键帧.ms",
        "按材质ID拆分模型.ms",
        "保持位移建立父子.ms",
        "PMX导入.ms",
        "清理根骨骼.ms",
        "Nahida.jpg"
      ],
      "destinationFolder": "LX-Max-Tools"
    }
  },
